# NoneBot / OneBot
HOST=0.0.0.0
PORT=8080
ASTCHO_ADMINS=123456789
ASTCHO_ALLOWED_GROUPS=123456789

# OpenAI-compatible text API
ASTCHO_LLM_API_KEY=replace-me
ASTCHO_LLM_BASE_URL=https://api.example.com/v1
ASTCHO_CHAT_MODEL=your-chat-model
ASTCHO_PLANNER_MODEL=your-fast-json-model
ASTCHO_PLANNER_API_KEY=
ASTCHO_PLANNER_BASE_URL=

# Reasoning Replyer (falls back to the normal Replyer if unavailable)
ASTCHO_REASONING_ENABLED=true
ASTCHO_REASONING_MODEL=your-reasoning-model
ASTCHO_REASONING_API_KEY=
ASTCHO_REASONING_BASE_URL=

# OpenAI-compatible vision API; omitted values fall back to the text API
ASTCHO_VISION_API_KEY=
ASTCHO_VISION_BASE_URL=
ASTCHO_VISION_MODEL=your-vision-model

# Local runtime data. This directory is ignored by Git.
ASTCHO_DATA_DIR=var
ASTCHO_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ASTCHO_SHORT_HISTORY_LIMIT=10
ASTCHO_MAX_MEMORIES=8
ASTCHO_MEME_LIMIT=300
ASTCHO_EXPRESSION_LEARNING=true
ASTCHO_EXPRESSION_LEARN_INTERVAL=900
ASTCHO_EXPRESSION_LEARN_MIN_MESSAGES=10
ASTCHO_FORWARD_MAX_TEXT_SEGMENTS=200
ASTCHO_FORWARD_MAX_MEDIA_SEGMENTS=20
ASTCHO_INPUT_PRICE_PER_MILLION=0
ASTCHO_OUTPUT_PRICE_PER_MILLION=0
ASTCHO_REPLY_COOLDOWN_SECONDS=5
ASTCHO_DEBUG=false
